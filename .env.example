# Credenciales de la cuenta de servicio de Firebase (Admin SDK).
# Copia este archivo a .env.local y coloca los valores reales.
# Nunca uses el prefijo NEXT_PUBLIC_ con estas variables.
PROJECT_ID=tu-proyecto
CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
